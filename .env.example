# ═══════════════════════════════════════════════════════════════════════════════
# Files Hub — Node Configuration
# Copy this file to .env and fill in your values.
# Same docker-compose.yml works for both roles — only these vars change.
# ═══════════════════════════════════════════════════════════════════════════════

# === NODE IDENTITY ===
NODE_MODE=directory                     # directory | storage
NODE_VERSION=1.0.0
LOG_LEVEL=info                          # debug | info | warn | error
HOST_OS=linux                           # linux | windows | macos
NODE_ID=my-node                         # Storage nodes: unique name (e.g. alice-desktop)
SELF_NODE_ID=my-node                    # Directory nodes: same as NODE_ID

# === MESH NETWORK ===
# Comma-separated list of ALL addresses this node can be reached at.
NODE_IP=10.0.0.5, example.com
# How to reach the directory node (Storage node only)
# DIR_NODE_IP=10.0.0.5, example.com
# Public URL of the directory node
# DIR_NODE_URL=https://file.kingservers.dns.army

# === AUTH ===
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_16
JWT_EXPIRY_HOURS=720                    # 30 days
# Federation token (Storage only, get from Admin -> Nodes -> Register)
# FEDERATION_TOKEN=paste_from_admin_panel
# Admin bootstrap (Directory only, created/synced on every startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# === STORAGE ===
DB_PATH=/data/registry.db
# Directories to share (Storage only, comma-separated absolute paths)
# MAPPED_ROOTS=/mnt/movies,/mnt/music,/home/user/documents

# === SEARCH ===
# Semantic search config moved to internal registry/defaults.

# === OPTIONAL FEATURES ===
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem
# Frontend
SERVE_REACT=true
REACT_STATIC_PATH=/app/frontend/dist
# Replica push interval
REPLICA_PUSH_INTERVAL=60

# VPS DEPLOY (optional — used by scripts/deploy-vps.sh)
# VPS_USER=ubuntu
# VPS_HOST=your-vps.example.com
# VPS_SSH_KEY=/path/to/key
# VPS_SSH_PORT=22
