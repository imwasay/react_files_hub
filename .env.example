# ═══════════════════════════════════════════════════════════════════════════════
# Files Hub — Node Configuration
# Copy this file to .env and fill in your values.
# Same docker-compose.yml works for both roles — only these vars change.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Role ─────────────────────────────────────────────────────────────────────
NODE_MODE=directory                     # directory | storage
NODE_VERSION=1.0.0
LOG_LEVEL=info                          # debug | info | warn | error
HOST_OS=linux                           # linux | windows | macos

# ── Node Identity ────────────────────────────────────────────────────────────
# Comma-separated list of ALL addresses this node can be reached at.
# The system tries each in order until one connects.
# Examples: LAN IP, VPN IP, IPv6, domain name
NODE_IP=10.0.0.5, example.com
NODE_ID=my-node                         # Storage nodes: unique name (e.g. alice-desktop)
SELF_NODE_ID=my-node                    # Directory nodes: same as NODE_ID

# ── TLS ──────────────────────────────────────────────────────────────────────
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem

# ── Auth (MUST be identical across ALL nodes in your mesh) ───────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_16
JWT_EXPIRY_HOURS=720                    # 30 days

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=/data/registry.db

# ═══════════════════════════════════════════════════════════════════════════════
# DIRECTORY NODE ONLY — ignore if NODE_MODE=storage
# ═══════════════════════════════════════════════════════════════════════════════

# Admin bootstrap (created/synced on every startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Semantic search (optional — leave blank to disable)
VECTOR_STORE_PATH=/data/vectors
VECTOR_STORE_BACKEND=chroma
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# LLM (optional — comma-separated Ollama hosts, tried in order)
LLM_PRIORITY_HOSTS=10.2.0.14:11434
LLM_HEALTH_CHECK_INTERVAL=30
LLM_MODEL=gemma3:4b

# Frontend
SERVE_REACT=true
REACT_STATIC_PATH=/app/frontend/dist

# Replica push interval
REPLICA_PUSH_INTERVAL=60

# ═══════════════════════════════════════════════════════════════════════════════
# STORAGE NODE ONLY — ignore if NODE_MODE=directory
# ═══════════════════════════════════════════════════════════════════════════════

# How to reach the directory node (comma-separated, tried in order)
# DIR_NODE_IP=10.0.0.5, example.com

# Federation token (get this from Admin → Nodes → Register)
# FEDERATION_TOKEN=paste_from_admin_panel

# Directories to share (comma-separated absolute paths)
# MAPPED_ROOTS=/mnt/movies,/mnt/music,/home/user/documents

# ═══════════════════════════════════════════════════════════════════════════════
# VPS DEPLOY (optional — used by scripts/deploy-vps.sh)
# ═══════════════════════════════════════════════════════════════════════════════

# VPS_USER=ubuntu
# VPS_HOST=your-vps.example.com
# VPS_SSH_KEY=/path/to/key
# VPS_SSH_PORT=22
