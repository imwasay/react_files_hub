# ═══════════════════════════════════════════════════════════════════════════════
# Files Hub — Node Configuration
# Copy this file to .env and fill in your values.
# Same docker-compose.yml works for both roles — only these vars change.
# ═══════════════════════════════════════════════════════════════════════════════

# === NODE IDENTITY ===
NODE_VERSION=1.0.0
LOG_LEVEL=info                          # debug | info | warn | error
HOST_OS=linux                           # linux | windows | macos
NODE_ID=my-node                         # Node's unique identifier (e.g. node_king_directory)
SELF_NODE_ID=my-node                    # Alias for node identity bootstrap

# === MESH NETWORK ===
# Comma-separated list of ALL addresses this node can be reached at.
NODE_IP=10.0.0.5, example.com

# Semicolon-separated list of peer nodes with their IP/address lists.
# Format: peer_id1=address1,address2;peer_id2=address3
PEER_NODES=node_king_directory=10.0.0.5:8000;hassan=alphaservers.dns.army:8000

# === AUTH ===
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_16
JWT_EXPIRY_HOURS=720                    # 30 days
# Federation token (Used to secure communications between nodes)
FEDERATION_TOKEN=CHANGE_ME_federation_key_between_all_nodes

# Admin bootstrap (created/synced on every startup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# === STORAGE ===
DB_PATH=/data/registry.db
# Directories to share (comma-separated absolute paths)
STORAGE_ROOTS=/mnt/movies,/mnt/music,/home/user/documents

# === OPTIONAL FEATURES ===
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem
# Frontend
SERVE_REACT=true
REACT_STATIC_PATH=/app/frontend/dist
