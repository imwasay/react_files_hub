# Production environment example for react_files_hub
# Copy this file to .env and fill in the actual values.

NODE_MODE=directory
NODE_VERSION=1.0.0
LOG_LEVEL=info
HOST_OS=linux

TLS_CERT_PATH=/etc/letsencrypt/live/yourdomain/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/yourdomain/privkey.pem

DOMAIN=yourdomain.com
NODE_PUBLIC_IPV4=YOUR_PUBLIC_IPV4
NODE_PUBLIC_IPV6=YOUR_PUBLIC_IPV6
NODE_WG_IP=YOUR_WIREGUARD_IP

SELF_NODE_ID=optiplex-main
SELF_NODE_SUBDOMAIN=file.ntrides.com.au

DB_PATH=/data/registry.db
VECTOR_STORE_PATH=/data/vectors
VECTOR_STORE_BACKEND=chroma

JWT_SECRET=change_this_secret
JWT_EXPIRY_HOURS=720

REPLICA_PUSH_INTERVAL=60
LLM_PRIORITY_HOSTS=
LLM_HEALTH_CHECK_INTERVAL=30
LLM_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text

SERVE_REACT=true
REACT_STATIC_PATH=/app/frontend/dist

# optional admin bootstrap credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_password

# optional VPS deploy settings for scripts/deploy-vps.sh
VPS_USER=ubuntu
VPS_HOST=wg.ntrides.com.au
VPS_SSH_KEY=/path/to/ssh-key-2025-10-16.key
VPS_SSH_PORT=22
VPS_REACT_PATH=/home/ubuntu/files_hub-react
VPS_EDGE_PATH=/home/ubuntu/files_hub-edge
