# Storage Node environment example for react_files_hub
# Copy to .env on the storage node and fill in real values.
# The storage node registers itself with the Directory Node via the federation token.

NODE_MODE=storage
NODE_VERSION=1.0.0
LOG_LEVEL=info
HOST_OS=linux

# ── Identity ───────────────────────────────────────────────────────────────────
# Unique identifier for this storage node — must match what the directory node
# expects. Use lowercase-dash format, e.g. "alice-home-server".
NODE_ID=friend-node-name

# ── Network ────────────────────────────────────────────────────────────────────
# WireGuard IP assigned to this node on the VPN subnet (ask the directory admin).
NODE_WG_IP=10.72.0.X
NODE_PUBLIC_IPV6=
# Storage nodes typically don't expose IPv4 directly — leave blank unless needed.

# Subdomain this node is reachable at from the directory node's NGINX
# (must be a subdomain of the main domain, e.g. "alice.ntrides.com.au").
# Required only if the node serves files directly. Otherwise leave blank.
NODE_SUBDOMAIN=

# ── Directory Node contact ─────────────────────────────────────────────────────
# Priority-ordered IPs to reach the directory node.
# WireGuard IP takes priority, then IPv6, then IPv4.
DIR_NODE_WG_IP=10.72.0.1
DIR_NODE_IPV6=
DIR_NODE_IPV4=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Federation token issued by the directory node admin.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FEDERATION_TOKEN=change_this_token

# JWT secret must match the directory node's JWT_SECRET exactly.
JWT_SECRET=change_this_secret

# ── Data paths ─────────────────────────────────────────────────────────────────
DB_PATH=/data/replica.db
VECTOR_STORE_PATH=/data/vectors
INGESTION_QUEUE_PATH=/data/ingest_queue

# ── Mapped roots ───────────────────────────────────────────────────────────────
# Comma-separated list of local paths to share.
# These paths must also be mounted into the Docker container
# (see docker-compose.storage.yml volumes section).
# Example: /mnt/share1,/mnt/share2
MAPPED_ROOTS=/mnt/share1

# ── Embedding model ────────────────────────────────────────────────────────────
# Run embedding locally (default) or point to an Ollama host.
# "local" = use sentence-transformers on this machine.
EMBED_HOST=local
EMBED_MODEL=nomic-embed-text

# ── LLM (optional — for local query acceleration) ─────────────────────────────
# Usually left blank on storage nodes — LLM runs on the directory node.
LLM_HOST=
LLM_MODEL=gemma3:4b

# ── Watcher / sync tuning ──────────────────────────────────────────────────────
WATCHER_DEBOUNCE_MS=2000
REPLICA_PUSH_INTERVAL=60
REPLICA_POLL_BASE=60
REPLICA_POLL_JITTER_MAX=30

# ── TLS (used if serving files directly over HTTPS) ───────────────────────────
# The push-cert.sh script in nginx_others/ can copy the wildcard cert here from
# the directory node via ssh.
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem
