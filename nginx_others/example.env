# =============================================================================
# ntrides — node environment configuration
# set NODE_MODE first, then fill only the section that applies to your mode
# =============================================================================

# shared across ALL modes — always fill these
NODE_MODE=directory              # directory | storage | vps-edge | offline-demo
NODE_VERSION=1.0.0
LOG_LEVEL=info                   # debug | info | warn | error
TLS_CERT_PATH=/certs/fullchain.pem
TLS_KEY_PATH=/certs/privkey.pem


# =============================================================================
# if NODE_MODE=directory
# your main Optiplex — the brain of the system
# =============================================================================

DOMAIN=ntrides.com.au
NODE_PUBLIC_IPV4=203.x.x.x           # your home public IPv4 (port-forwarded)
NODE_PUBLIC_IPV6=2001:db8::1          # your home public IPv6

# database
DB_PATH=/data/registry.db
VECTOR_STORE_PATH=/data/vectors
VECTOR_STORE_BACKEND=chroma           # chroma | qdrant | pgvector

# auth
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRY_HOURS=24

# replica sync — push diffs to storage nodes every N seconds
REPLICA_PUSH_INTERVAL=60

# LLM — tried in order, first healthy one wins
LLM_PRIORITY_HOSTS=10.2.0.14:11434,10.0.0.17:11434
LLM_HEALTH_CHECK_INTERVAL=30         # seconds between health checks
LLM_MODEL=gemma3:4b
EMBED_MODEL=nomic-embed-text

# react
SERVE_REACT=true
REACT_STATIC_PATH=/app/frontend/dist

# wireguard
WG_INTERFACE=wg0
NODE_WG_IP=10.214.83.1


# =============================================================================
# if NODE_MODE=storage
# a friend's machine — stores files, replicates registry, runs ingestion
# =============================================================================

NODE_ID=node-b                        # unique identifier for this node
NODE_WG_IP=10.214.83.2
NODE_PUBLIC_IPV6=2001:db8::2          # this node's dynamic public IPv6
NODE_SUBDOMAIN=b.ntrides.com.au

# directory node contact — tried in this order
DIR_NODE_WG_IP=10.214.83.1
DIR_NODE_IPV6=2001:db8::1
DIR_NODE_IPV4=203.x.x.x              # fallback if WG and IPv6 both unreachable

# filesystem mappings — comma separated absolute paths to share
# these are the real local paths that get mapped into the system
MAPPED_ROOTS=/mnt/share1,/mnt/share2,/home/user/notes

# registry replica polling
REPLICA_POLL_BASE=60                  # base interval in seconds
REPLICA_POLL_JITTER_MAX=30            # random 0-N seconds added to base

# file watcher
WATCHER_DEBOUNCE_MS=2000              # wait this long after last change before reporting

# ingestion
EMBED_MODEL=nomic-embed-text
EMBED_HOST=local                      # local = run embedding on this node
INGESTION_QUEUE_PATH=/data/ingest_queue

# LLM — point to directory node's LLM proxy, or directly to LLM host if reachable
LLM_HOST=10.214.83.1:11434

# auth — storage nodes validate JWTs locally, no roundtrip to directory node
JWT_SECRET=replace_with_same_secret_as_directory_node

# wireguard
WG_INTERFACE=wg0


# =============================================================================
# if NODE_MODE=vps-edge
# Oracle Sydney — ultra lightweight, no DB, no LLM, no ingestion
# =============================================================================

NODE_PUBLIC_IPV4=x.x.x.x             # VPS public IPv4
NODE_PUBLIC_IPV6=2001:db8::vps        # VPS public IPv6

# directory node contact via existing WG tunnel
DIR_NODE_WG_IP=10.72.0.1             # your home server on the sydney WG tunnel
DIR_NODE_IPV4=203.x.x.x
DIR_NODE_IPV6=2001:db8::1

# react static — pre-built and copied here during deploy
REACT_STATIC_PATH=/var/www/ntrides

# registry cache — serve this when directory node unreachable
REGISTRY_CACHE_PATH=/data/registry_cache.json
REGISTRY_CACHE_TTL=120                # seconds before cache is considered stale

# proxy
PROXY_FALLBACK=true                   # proxy file bytes if client has no IPv6 path
NGINX_CONFIG_PATH=/etc/nginx/conf.d/ntrides.conf

# auth
JWT_SECRET=replace_with_same_secret_as_directory_node

# wireguard
WG_INTERFACE=wg-sydney


# =============================================================================
# if NODE_MODE=offline-demo
# college hall — plugged into a switch, no internet
# all nodes use this in addition to their usual directory/storage vars above
# =============================================================================

WG_DISABLED=true                      # skip wireguard entirely, LAN routing only
FORCE_IPV4=true                       # don't attempt IPv6 at all

LOCAL_DNS_OVERRIDE=true               # tell Pi-hole to serve ntrides.com.au locally
PIHOLE_HOST=192.168.x.y              # your machine running Pi-hole on LAN
PIHOLE_API_KEY=your_pihole_api_key

DIR_NODE_LAN_IP=192.168.x.y          # your Optiplex's LAN IP on the switch
LAN_SUBNET=192.168.x.x/24

# override domain resolution to LAN — same certs, same code, just different routing
DOMAIN=ntrides.com.au                 # unchanged, Pi-hole resolves it to LAN IP
