[Unit]
Description=ntrides edge service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/files-edge
EnvironmentFile=/home/ubuntu/files-edge/.env
ExecStart=/home/ubuntu/files-edge/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
